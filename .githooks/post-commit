#!/usr/bin/env bash
set -euo pipefail

if [[ "${SKIP_PLAN_APPROVAL_HOOK:-0}" == "1" ]]; then
  exit 0
fi

# Trigger only for explicit plan-approval commits.
msg="$(git log -1 --pretty=%B | tr '[:upper:]' '[:lower:]')"
if ! [[ "$msg" =~ (\[plan-approved\]|plan\ approved|approve\ plan) ]]; then
  exit 0
fi

if ! git show --name-only --pretty='' HEAD | rg -q '^docs/plans/'; then
  exit 0
fi

if [[ ! -x ".venv/bin/python" ]]; then
  echo "post-commit plan hook: .venv/bin/python not found; skipping auto-audit" >&2
  exit 0
fi

.venv/bin/python scripts/audit_plans_doneness.py

latest_audit="$(ls -1t docs/plans/plan-doneness-audit-auto-*.md 2>/dev/null | head -n1 || true)"
if [[ -z "$latest_audit" ]]; then
  exit 0
fi

git add "$latest_audit"

if git diff --cached --quiet; then
  exit 0
fi

SKIP_PLAN_APPROVAL_HOOK=1 git commit -m "Refresh auto plan doneness audit"
